# OpsPilot Configuration Example
PROJECT_NAME="OpsPilot"
API_V1_STR="/api/v1"
SECRET_KEY="opspilot-super-secure-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For Local Dev with SQLite:
DATABASE_URL="sqlite+aiosqlite:///./opspilot.db"
# For Docker / PostgreSQL 16 with pgvector:
# DATABASE_URL="postgresql+asyncpg://opspilot:opspilot_password@localhost:5432/opspilot"

# Redis
REDIS_URL="redis://localhost:6379/0"

# MinIO / S3 Object Storage
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="opspilot-docs"

# AI Gateway & Models (Zero-Cost Multi-Provider Architecture)
AI_ENABLED=true
LLM_PROVIDER="router"  # "router" for multi-provider failover, or "groq", "gemini", "ollama", "mock"
AI_DEFAULT_DATA_CLASS="internal"  # "public_demo", "internal", "confidential"
AI_TOTAL_DEADLINE_SECONDS=25.0
AI_QUOTA_HEADROOM_PERCENT=15
DEFAULT_MONTHLY_AI_BUDGET_USD=0.0  # Rule R3: Hard budget $0.00 forever

# Free-tier AI Provider API Keys (no-card free accounts)
GEMINI_API_KEY=""        # Google AI Studio (free tier)
GROQ_API_KEY=""          # Groq Console (free tier)
CF_ACCOUNT_ID=""         # Cloudflare Account ID
CF_API_TOKEN=""          # Cloudflare Workers AI API Token
MISTRAL_API_KEY=""       # Mistral La Plateforme (free tier)
OPENROUTER_API_KEY=""    # OpenRouter API Key (only :free models consumed)

# Observability (Free Tier)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Ollama Local Settings (legacy & confidential fallback)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_CHAT_MODEL="qwen3:4b"
OLLAMA_FAST_MODEL="qwen2.5:3b-instruct"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=120
MOCK_AI_PROVIDER=false
OPENAI_API_KEY=""
DEFAULT_FAST_MODEL="qwen2.5:3b-instruct"
DEFAULT_REASONING_MODEL="qwen3:4b"
DEFAULT_REVIEW_MODEL="qwen2.5:3b-instruct"
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"
